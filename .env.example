# 环境变量样例。本地开发无需任何配置：不设置 TURSO_DATABASE_URL 时自动使用本地 SQLite
# 文件 server/data/resume.db（node:sqlite）。
#
# 部署到 Vercel（Serverless，无持久磁盘）时必须配置下面两项，数据才会持久保存。
# 获取方式：
#   turso db create resume-studio
#   turso db show resume-studio --url          -> TURSO_DATABASE_URL
#   turso db tokens create resume-studio       -> TURSO_AUTH_TOKEN

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 自托管时可选：自定义 SQLite 文件位置（例如挂载的持久卷）
# RESUME_DB=/data/resume.db

# 本地服务端口（默认 3001）
# PORT=3001
